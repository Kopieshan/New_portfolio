---
---
<section class="flex flex-col gap-16 max-w-7xl mx-auto px-8 pt-20" id="projects">
    <div class="flex flex-col gap-2">
        <h1 class="text-headline-lg text-headline-lg md:text-display text-on-surface relative inline-block">
            My Work
            <span class="absolute -bottom-2 left-0 w-24 h-1 bg-primary rounded"></span>
        </h1>
        <p class="text-body-lg text-on-surface-variant max-w-2xl mt-4">A selection of recent engineering projects, highlighting scalable architectures, modern tech stacks, and precise execution.</p>
    </div>
    
    <!-- Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Project 1 -->
        <article class="glass-card rounded-lg overflow-hidden flex flex-col relative group">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(173,198,255,0.05),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="h-48 w-full bg-surface-container overflow-hidden border-b border-white/5">
                <img class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" alt="An abstract close-up of a computer monitor displaying syntax-highlighted code." src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-4p3OyjRRfRsiGyuEKI2LmTGgO1OEQQtLbbkGdFdCioMckl-At-WbicBBcRGAwesL_J_4Mr4LI58M99ntVfhXlQYnAaAu55cM2n0BMHxDY2EWPZPMggBGctcAqBjsZpNMXj0xWFd9PRV0bn-TShmjcUXv9MdVZ3qw9aRwK4rbmuT_tbq9OYmUicSvd3PoQlG_skM8oT3IlauGGFWbnnZ6IRH9VjJDkERu4f-kvydgGWOcEtAJyso3FoTQ3tkpkJe2j_l7iSgcq3cu"/>
            </div>
            <div class="p-6 flex flex-col gap-4 flex-grow">
                <h3 class="text-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Project Alpha</h3>
                <p class="text-body-sm text-on-surface-variant flex-grow">A high-performance real-time analytics dashboard built for enterprise scale, processing millions of events per second with sub-second latency.</p>
                <div class="flex flex-wrap gap-2 mt-2">
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">React</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Supabase</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Go</span>
                </div>
            </div>
            <div class="px-6 pb-6 flex gap-4 pt-4 border-t border-white/5">
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">code</span> GitHub
                </a>
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">open_in_new</span> Live Demo
                </a>
            </div>
        </article>
        
        <!-- Project 2 -->
        <article class="glass-card rounded-lg overflow-hidden flex flex-col relative group">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(173,198,255,0.05),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="h-48 w-full bg-surface-container overflow-hidden border-b border-white/5">
                <img class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" alt="A sleek, modern data visualization dashboard displayed on a screen in a dark room." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCYDqg-w3Q8ylboS8TuvG5jtUT0zIqqY_h9dlBeLky1fudA02XmZshBGiRiEpcqmQ6CdqTwz89WTtYIm9sXDkYz41upIqDRpKxsGpUqAyg3_vjRGsHdM3FVHrDOtohTm78O1bA-NfvW6xXTN74TF5In1C-CYQZXd22y9CJFNMGfW_PIJ7IsqWw-PmZ9kKmEYGKzrx3tobR-PmpWrYNL5G_oZvthfgCYx5PBRG10-Hnisyb_r0N1faMvFp8pLnxD9jq1ch5bcYZrteh1"/>
            </div>
            <div class="p-6 flex flex-col gap-4 flex-grow">
                <h3 class="text-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Nexus Core</h3>
                <p class="text-body-sm text-on-surface-variant flex-grow">An open-source distributed task queue prioritizing developer ergonomics and operational simplicity without sacrificing throughput.</p>
                <div class="flex flex-wrap gap-2 mt-2">
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">TypeScript</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Redis</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Docker</span>
                </div>
            </div>
            <div class="px-6 pb-6 flex gap-4 pt-4 border-t border-white/5">
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">code</span> GitHub
                </a>
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">menu_book</span> Docs
                </a>
            </div>
        </article>
        
        <!-- Project 3 -->
        <article class="glass-card rounded-lg overflow-hidden flex flex-col relative group">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(173,198,255,0.05),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="h-48 w-full bg-surface-container overflow-hidden border-b border-white/5">
                <img class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" alt="A minimalist cloud architecture diagram rendered in a digital style." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPN4GfuecU_z6z5W-LnQgZphkK2UWcjJl2HTc-MM7N7RBBKQ0dTDBcLPfe-H7TxeoS7V8QHEIcWXL1ICVDw_WobY-Mzgbz5Cp3Q0gmJiHHdj7TuN64Gri9XqdRP_8efFomxXwNGmEcI5HODDr-C1W2tbeQrskd9z0kCC92d-j-B8NG1pfgHrB4QFAWkbNTDxVCA4NM0q4P7RlbGr3WamsM_saRWj_vG4YC9zWfGQLwOMTnVITIpEh8v9lKCemjfRGlyFo96cwtyzdG"/>
            </div>
            <div class="p-6 flex flex-col gap-4 flex-grow">
                <h3 class="text-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Aether UI</h3>
                <p class="text-body-sm text-on-surface-variant flex-grow">A headless component library engineered for absolute performance and accessibility, currently powering dozens of high-traffic applications.</p>
                <div class="flex flex-wrap gap-2 mt-2">
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Vue</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Tailwind</span>
                    <span class="bg-primary/10 text-primary text-label-md px-2 py-1 rounded-full border border-primary/20">Vite</span>
                </div>
            </div>
            <div class="px-6 pb-6 flex gap-4 pt-4 border-t border-white/5">
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">code</span> GitHub
                </a>
                <a class="flex items-center gap-1 text-label-md text-on-surface hover:text-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">open_in_new</span> Npm
                </a>
            </div>
        </article>
    </div>
</section>
