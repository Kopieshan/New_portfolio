---
---
<section class="flex flex-col gap-8 border-t border-white/5 pt-16 max-w-7xl mx-auto px-8 mt-16">
    <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-primary text-[32px]">workspace_premium</span>
        <h2 class="text-headline-md text-headline-md text-on-surface">Certifications</h2>
    </div>
    <div class="horizontal-scroll flex gap-6 overflow-x-auto pb-6 snap-x">
        <!-- Cert 1 -->
        <div class="glass-card min-w-[300px] p-6 rounded-lg flex flex-col gap-4 snap-start group relative">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(173,198,255,0.05),transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="flex justify-between items-start">
                <div class="w-12 h-12 bg-white/5 rounded flex items-center justify-center border border-white/10 group-hover:border-primary/50 transition-colors">
                    <span class="material-symbols-outlined text-on-surface">cloud</span>
                </div>
                <span class="text-code text-code text-on-surface-variant">2023</span>
            </div>
            <div>
                <h4 class="text-headline-sm text-[20px] font-semibold text-on-surface leading-tight">AWS Certified Solutions Architect</h4>
                <p class="text-body-sm text-on-surface-variant mt-1">Amazon Web Services</p>
            </div>
            <div class="mt-auto pt-4 border-t border-white/5">
                <a class="inline-flex items-center gap-1 text-label-md text-primary hover:text-primary-fixed transition-colors" href="#">
                    Verify Credential <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
        
        <!-- Cert 2 -->
        <div class="glass-card min-w-[300px] p-6 rounded-lg flex flex-col gap-4 snap-start group relative">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(173,198,255,0.05),transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="flex justify-between items-start">
                <div class="w-12 h-12 bg-white/5 rounded flex items-center justify-center border border-white/10 group-hover:border-primary/50 transition-colors">
                    <span class="material-symbols-outlined text-on-surface">memory</span>
                </div>
                <span class="text-code text-code text-on-surface-variant">2022</span>
            </div>
            <div>
                <h4 class="text-headline-sm text-[20px] font-semibold text-on-surface leading-tight">Google Cloud Professional Cloud Architect</h4>
                <p class="text-body-sm text-on-surface-variant mt-1">Google</p>
            </div>
            <div class="mt-auto pt-4 border-t border-white/5">
                <a class="inline-flex items-center gap-1 text-label-md text-primary hover:text-primary-fixed transition-colors" href="#">
                    Verify Credential <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
        
        <!-- Cert 3 -->
        <div class="glass-card min-w-[300px] p-6 rounded-lg flex flex-col gap-4 snap-start group relative">
            <div class="absolute -z-10 inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(173,198,255,0.05),transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="flex justify-between items-start">
                <div class="w-12 h-12 bg-white/5 rounded flex items-center justify-center border border-white/10 group-hover:border-primary/50 transition-colors">
                    <span class="material-symbols-outlined text-on-surface">terminal</span>
                </div>
                <span class="text-code text-code text-on-surface-variant">2022</span>
            </div>
            <div>
                <h4 class="text-headline-sm text-[20px] font-semibold text-on-surface leading-tight">Certified Kubernetes Administrator (CKA)</h4>
                <p class="text-body-sm text-on-surface-variant mt-1">Cloud Native Computing Foundation</p>
            </div>
            <div class="mt-auto pt-4 border-t border-white/5">
                <a class="inline-flex items-center gap-1 text-label-md text-primary hover:text-primary-fixed transition-colors" href="#">
                    Verify Credential <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>
</section>
