<section class="py-4xl px-margin max-w-7xl mx-auto" id="about">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-xl items-center">
        <!-- Avatar Column -->
        <div class="md:col-span-4 flex justify-center relative">
            <!-- Glow effect behind avatar -->
            <div class="absolute inset-0 bg-primary/20 blur-[60px] rounded-full -z-10"></div>
            <img class="w-64 h-64 object-cover rounded-2xl glass-panel grayscale hover:grayscale-0 transition-all duration-500" alt="A high-quality professional portrait of a modern technical professional in a dimly lit, high-tech environment." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCANjJtpOLeUdYYginPB1E2-_vUOBKy6SG5Cel-JYF2m6yVYZ86f5iwK9omfVr9vSpztX1PpcCIu_RaocBYY8-HWI1-X5Z6V3makX_yi9Z64aClbGFMITayIPIaH3tGcRzCsua36tLnxj-D6aYYv6qLOx-gT-bo1QPF7rKbFfXtWPYGWLCJ7BeOjll3YQ3vw1kvXd3mmGtibGkVcY6RJMlOnEuuRKc7P_eteI_DvHF1kssoX9lOSxBJi_lqUVFa1fs94Iagge4lwAal"/>
        </div>
        
        <!-- Bio Column -->
        <div class="md:col-span-8 flex flex-col gap-lg">
            <div>
                <h2 class="font-headline-lg text-headline-lg text-on-surface mb-md">About Me</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                    I am a multidisciplinary developer and designer focused on bridging the gap between elegant interfaces and robust technical architecture. With a deep passion for minimalist aesthetics and high-performance systems, I build tools that empower users and elevate digital experiences.
                </p>
            </div>
            
            <!-- Tech Stack -->
            <div>
                <h3 class="font-label-md text-label-md text-outline uppercase tracking-wider mb-sm">Tech Stack</h3>
                <div class="flex flex-wrap gap-sm">
                    <span class="chip px-md py-xs rounded-full font-code text-code">React</span>
                    <span class="chip px-md py-xs rounded-full font-code text-code">Next.js</span>
                    <span class="chip px-md py-xs rounded-full font-code text-code">TypeScript</span>
                    <span class="chip px-md py-xs rounded-full font-code text-code">Tailwind</span>
                    <span class="chip px-md py-xs rounded-full font-code text-code">Node.js</span>
                </div>
            </div>
        </div>
    </div>
</section>
