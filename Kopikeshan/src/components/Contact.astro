---
---
<section class="flex-grow pt-[120px] pb-20 px-8 relative z-10 flex flex-col items-center justify-center max-w-7xl mx-auto" id="contact">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Header Section -->
        <div class="col-span-1 lg:col-span-12 mb-16 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-surface-container border border-outline-variant mb-4">
                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                <span class="text-label-md text-label-md text-on-surface-variant uppercase">Open to work</span>
            </div>
            <h1 class="text-display text-display text-on-surface mb-4">Let's Build <br class="hidden md:block"/>Something Together.</h1>
            <p class="text-body-lg text-body-lg text-on-surface-variant max-w-2xl">
                Whether you have a full product vision, a technical challenge, or just a seed of an idea—I'm ready to collaborate. Drop a message and let's engineer the future.
            </p>
        </div>
        
        <!-- Left Col: Contact Info & Socials -->
        <div class="col-span-1 lg:col-span-4 flex flex-col gap-6">
            <div class="glass-panel p-6 rounded-xl relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-br from-primary-container/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <h3 class="text-headline-sm text-headline-sm text-on-surface mb-2">Direct Contact</h3>
                <p class="text-body-md text-body-md text-on-surface-variant mb-6">Prefer standard communication channels? Reach out directly.</p>
                <div class="flex flex-col gap-4">
                    <a href="mailto:hello@johndoe.com" class="flex items-center gap-4 text-on-surface-variant hover:text-primary transition-colors group/link">
                        <span class="material-symbols-outlined p-2 rounded bg-surface-container border border-outline-variant group-hover/link:border-primary/50 transition-colors">mail</span>
                        <span class="text-code text-code">hello@johndoe.com</span>
                    </a>
                    <div class="flex items-center gap-4 text-on-surface-variant">
                        <span class="material-symbols-outlined p-2 rounded bg-surface-container border border-outline-variant">location_on</span>
                        <span class="text-code text-code">San Francisco, CA</span>
                    </div>
                </div>
            </div>
            
            <div class="glass-panel p-6 rounded-xl relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-br from-primary-container/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <h3 class="text-headline-sm text-headline-sm text-on-surface mb-4">Digital Presence</h3>
                <div class="flex flex-wrap gap-2">
                    <a href="#" class="p-4 rounded bg-surface-container border border-outline-variant hover:border-primary hover:text-primary transition-all duration-300 flex items-center justify-center">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
                    </a>
                    <a href="#" class="p-4 rounded bg-surface-container border border-outline-variant hover:border-primary hover:text-primary transition-all duration-300 flex items-center justify-center">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
                    </a>
                    <a href="#" class="p-4 rounded bg-surface-container border border-outline-variant hover:border-primary hover:text-primary transition-all duration-300 flex items-center justify-center">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path></svg>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Right Col: Form -->
        <div class="col-span-1 lg:col-span-8">
            <div class="glass-panel p-8 md:p-12 rounded-xl relative group overflow-hidden">
                <div class="radial-glow"></div>
                <form id="contactForm" class="relative z-10 flex flex-col gap-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="floating-label-group">
                            <input type="text" id="name" required placeholder=" " class="text-body-md text-body-md font-medium" />
                            <label for="name" class="text-label-md">Full Name</label>
                        </div>
                        <div class="floating-label-group">
                            <input type="email" id="email" required placeholder=" " class="text-body-md text-body-md font-medium" />
                            <label for="email" class="text-label-md">Email Address</label>
                        </div>
                    </div>
                    <div class="floating-label-group mt-4">
                        <input type="text" id="subject" required placeholder=" " class="text-body-md text-body-md font-medium" />
                        <label for="subject" class="text-label-md">Subject / Project Type</label>
                    </div>
                    <div class="floating-label-group mt-4">
                        <textarea id="message" rows="5" required placeholder=" " class="text-body-md text-body-md font-medium resize-none"></textarea>
                        <label for="message" class="text-label-md">Your Message</label>
                    </div>
                    <div class="mt-8 flex justify-end">
                        <button type="submit" id="submitBtn" class="bg-primary-container text-on-primary-container px-12 py-4 rounded text-label-md text-label-md uppercase tracking-wider glow-button flex items-center justify-center gap-2 min-w-[200px]">
                            <span>Send Message</span>
                            <span class="material-symbols-outlined text-[18px]">send</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('contactForm');
    if (form) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const originalContent = btn.innerHTML;
            
            // Set loading state
            btn.classList.add('btn-loading');
            
            // Simulate network request
            setTimeout(() => {
                btn.classList.remove('btn-loading');
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span><span>Sent Successfully</span>';
                btn.classList.remove('bg-primary-container', 'text-on-primary-container');
                btn.classList.add('bg-green-600/20', 'text-green-400', 'border', 'border-green-500/50');
                
                // Reset form
                form.reset();
                
                // Reset button after delay
                setTimeout(() => {
                    btn.innerHTML = originalContent;
                    btn.classList.remove('bg-green-600/20', 'text-green-400', 'border', 'border-green-500/50');
                    btn.classList.add('bg-primary-container', 'text-on-primary-container');
                }, 3000);
            }, 1500);
        });
    }

    // Add subtle mouse tracking glow to cards
    document.querySelectorAll('.glass-panel').forEach(card => {
        card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const glow = card.querySelector('.radial-glow') as HTMLElement;
            if(glow) {
                glow.style.left = `${x - 200}px`;
                glow.style.top = `${y - 200}px`;
            }
        });
    });
</script>
